# Copy these settings into your existing .env.development (never commit real keys).
# Copy the gateway URL and X-RapidAPI-Host exactly from your subscribed RapidAPI Playground code snippet.
RAPIDAPI_KEY=
RAPIDAPI_HANDWRITING_ENDPOINT=
RAPIDAPI_HANDWRITING_HOST=

# Restrict paid API usage to your test account(s). Required even for development.
HANDWRITING_MVP_ALLOWED_EMAILS=you@example.com

# Set ONLY if RapidAPI returns image URLs. Exact image hostnames, no wildcards.
# e.g. media.vendor.example (from an actual API response)
RAPIDAPI_RESULT_HOSTS=
